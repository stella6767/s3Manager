@import freeapp.me.s3manager.web.dto.*
@import org.springframework.data.domain.Page

@param bucket: String
@param objects: List<S3ObjectInfo>
@param currentPath: String
@param breadcrumbs: List<BreadcrumbItem>
@param size: Int
@param continuationToken:String


@template.layout.main(content = @`

    <div id="s3-list" class="container mx-auto p-4 max-w-7xl">
        <!-- Header -->
        <div class="navbar bg-base-100 border-b mb-6">
            <div class="navbar-start">
                <h1 class="text-2xl font-bold text-primary">S3 Browser</h1>
                <div class="badge badge-outline ml-3">${bucket}</div>
            </div>
            <div class="navbar-end">
                <button id="refresh-btn" class="btn btn-outline btn-sm mr-2"
                        hx-get="/s3/list"
                        <%--                    hx-vals='{"prefix": "${currentPath}", "page": "${objects.number + 1}"}'--%>
                        hx-target="#main-content"
                        hx-swap="innerHTML">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                    새로고침
                </button>

            </div>
        </div>

        <!-- Breadcrumb Navigation -->
        @if(breadcrumbs.isNotEmpty())
            <div class="breadcrumbs text-sm mb-4">
                <ul>
                    <li>
                        <a href="#"
                           hx-get="/s3/list"
                           hx-vals='{"prefix": "", "page": "1"}'
                           hx-target="#main-content"
                           hx-swap="innerHTML">
                            🪣 ${bucket}
                        </a>
                    </li>
                    @for(crumb in breadcrumbs)
                        <li>
                            <a href="#"
                               hx-get="/s3/list"
                               hx-vals='{"prefix": "${crumb.path}", "page": "1"}'
                               hx-target="#main-content"
                               hx-swap="innerHTML">
                                ${crumb.name}
                            </a>
                        </li>
                    @endfor
                </ul>
            </div>
        @endif


        <div class="flex justify-between items-center mb-4">
            <div class="input-group flex gap-1">
                <input type="text"
                       id="search-input"
                       placeholder="객체 이름으로 검색..."
                       class="input input-bordered flex-1"
                       onkeyup="handleSearch(event)"/>
                <button class="btn btn-square" onclick="performSearch()">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </button>
            </div>
            <div class="flex items-center gap-2">
                <label class="text-sm">페이지당 표시:</label>
                <select id="size-select"
                        name="size"
                        class="select select-bordered select-sm"
                        hx-get="/s3/browser"
                        hx-trigger="change"
                        hx-target="#objects-container"
                        hx-swap="outerHTML"
                >
                    <option value="20" selected="${size == 20}">20개</option>
                    <option value="50" selected="${size == 50}">50개</option>
                    <option value="100" selected="${size == 100}">100개</option>
                </select>

            </div>
        </div>


        <!-- Objects List -->
        @template.components.s3.objectList(
        objects = objects,
        currentPath = currentPath,
        continuationToken = continuationToken
        )

    </div>

    <script>
        function handleSearch(event) {
            if (event.key === 'Enter') {
                performSearch();
            }
        }

        function performSearch() {
            const query = document.getElementById('search-input').value;
            const currentPath = '${currentPath}';

            htmx.ajax('GET', '/s3/search', {
                values: {
                    query: query,
                    prefix: currentPath,
                    page: 1
                },
                target: '#objects-container',
                swap: 'innerHTML'
            });
        }

        function getCurrentPath() {
            return '${currentPath}';
        }
    </script>

`)
