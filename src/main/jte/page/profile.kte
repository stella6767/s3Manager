@import freeapp.me.s3manager.web.dto.UserResponseDto

@param currentUser:UserResponseDto

@template.layout.main(content = @`
    <main id="main-container"
          class="bg-gray-50 min-h-screen flex flex-col items-center">
        @template.components.auth.profileBox(currentUser = currentUser)
    </main>

`)
