@import freeapp.me.s3manager.web.dto.*
@import org.springframework.data.domain.Page

@param objects: Page<S3ObjectInfo>
@param currentPath: String


<!-- Object Count Info -->
<div class="flex justify-between items-center mb-4">
    <div class="text-sm text-gray-600">
        총 ${objects.totalElements}개 객체 (${objects.number + 1}/${objects.totalPages} 페이지)
    </div>
    <div class="flex items-center gap-2">
        <label class="text-sm">페이지당 표시:</label>
        <select class="select select-bordered select-sm" onchange="changePageSize(this.value)">
            <option value="20" selected>20개</option>
            <option value="50">50개</option>
            <option value="100">100개</option>
        </select>
    </div>
</div>

<!-- Objects Table -->
<div class="overflow-x-auto">
    <table class="table table-zebra w-full">
        <thead>
        <tr>
            <th class="w-16">타입</th>
            <th>이름</th>
            <th class="w-32">크기</th>
            <th class="w-48">수정일</th>
        </tr>
        </thead>
        <tbody>
        @if(objects.isEmpty)
            <tr>
                <td colspan="4" class="text-center py-8">
                    <div class="flex flex-col items-center">
                        <svg class="w-16 h-16 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
                        </svg>
                        <p class="text-lg font-medium text-gray-400">객체가 없습니다</p>
                        <p class="text-sm text-gray-400 mt-1">이 경로에는 파일이나 폴더가 없습니다</p>
                    </div>
                </td>
            </tr>
        @else
            @for(obj in objects)
                <tr class="hover:bg-base-200 cursor-pointer"
                    onclick="handleObjectClick('${obj.key}', ${obj.isDirectory})">
                    <td>
                        <span class="text-2xl">${obj.getFileIcon()}</span>
                    </td>
                    <td>
                        <div class="flex items-center gap-2">
                            <span class="font-medium">${obj.name}</span>
                            @if(!obj.isDirectory && obj.extension.isNotEmpty())
                                <span class="badge badge-ghost badge-sm">${obj.extension}</span>
                            @endif
                        </div>
                    </td>
                    <td>
                        @if(!obj.isDirectory)
                            <span class="text-sm">${obj.getFormattedSize()}</span>
                        @else
                            <span class="text-gray-400">-</span>
                        @endif
                    </td>
                    <td>
                        <span class="text-sm">${obj.getFormattedDate()}</span>
                    </td>
                </tr>
            @endfor
        @endif
        </tbody>
    </table>
</div>

<!-- Pagination -->
