<script>
    function handleObjectClick(key, isDirectory) {
        if (isDirectory) {
            // 폴더 클릭시 해당 폴더로 이동
            htmx.ajax('GET', '/s3/list', {
                values: {
                    prefix: key,
                    page: 1
                },
                target: '#main-content',
                swap: 'innerHTML'
            });
        } else {
            // 파일 클릭시 객체 정보 표시 (또는 다운로드)
            showObjectInfo(key);
        }
    }

    function showObjectInfo(key) {
        // 모달이나 사이드 패널로 객체 정보 표시
        htmx.ajax('GET', '/s3/object-info', {
            values: {key: key},
            target: '#object-info-modal',
            swap: 'innerHTML'
        });
        document.getElementById('object-info-modal').showModal();
    }

    function changePageSize(size) {
        const currentPath = '${currentPath}';
        htmx.ajax('GET', '/s3/list', {
            values: {
                prefix: currentPath,
                page: 1,
                size: size
            },
            target: '#objects-container',
            swap: 'innerHTML'
        });
    }
</script>
