<%--                        hx-vals='{"prefix": "${currentPath}", "page": "${currentPage - 1}"}'--%>
<%--                        hx-target="#objects-container"--%>
<%--                        hx-swap="innerHTML">--%>
<%--                    «--%>
<%--                </button>--%>
<%--            @else--%>
<%--                <button class="join-item btn btn-sm btn-disabled">«</button>--%>
<%--            @endif--%>

