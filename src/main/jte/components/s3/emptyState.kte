@param title: String = "비어있음"
@param description: String = "항목이 없습니다"
@param icon: String = "folder"

<div class="text-center py-16">
    <div class="mx-auto w-24 h-24 mb-6">
        @if(icon == "folder")
            <svg class="w-full h-full text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
            </svg>
        @elseif(icon == "search")
            <svg class="w-full h-full text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
        @else
            <svg class="w-full h-full text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
        @endif
    </div>
    <h3 class="text-xl font-medium text-gray-500 mb-2">${title}</h3>
    <p class="text-gray-400">${description}</p>

    @if(icon == "folder")
        <div class="mt-6 space-x-2">
            <button class="btn btn-primary btn-sm" onclick="triggerFileUpload()">
                파일 업로드
            </button>
            <button class="btn btn-outline btn-sm" onclick="createFolder()">
                폴더 생성
            </button>
        </div>
    @endif
</div>
