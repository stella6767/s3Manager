
@import freeapp.me.s3manager.web.dto.FolderTreeNode

@param node: FolderTreeNode
@param level: Int
@param currentPath: String

<div class="ml-${level * 4}">
    <div class="folder-tree-item flex items-center ${if(currentPath == node.path)  "active" else ""}"
         hx-get="/s3/list"
         hx-vals='{"prefix": "${node.path}"}'
         hx-target="#file-content-area"
         hx-swap="innerHTML">
        <span class="mr-2">${if (node.children.isEmpty()) "📂" else "📁"}</span>
        <span class="text-sm">${node.name}</span>
    </div>

    @for(child in node.children)
        @template.components.s3.folderTreeNode(node = child, level = level + 1, currentPath = currentPath)
    @endfor
</div>

