@param content: gg.jte.Content

<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <script defer src="/js/htmx.min.js"></script>
    <script defer src="/js/htmx-extensions.js"></script>
    <script defer src="/js/response-targets.js"></script>
    <script defer src="/js/sign.js"></script>
    <script defer src="/js/upload.js"></script>
    <link href="/css/custom.css" rel="stylesheet">
    <link href="/css/main.css" rel="stylesheet">
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type">
    <meta charset="UTF-8">
    <meta content="stella6767" name="author">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
</head>

<body id="body" hx-ext="response-targets" hx-indicator=".loading-bar" class="flex flex-col min-h-screen">
<div class="loading-bar"></div>
<div id="error-alert-container"></div>

@template.layout.navbar()

<div id="content-body" class="py-3 flex-grow">

    ${content}

</div>


@template.layout.footer()
</body>
</html>
